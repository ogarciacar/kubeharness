[
 [
  "click",
  "button[data-profile=\"gateway-api\"]"
 ],
 [
  "click",
  "button[data-scenario=\"G01\"]"
 ],
 [
  "eval",
  "JSON.stringify(kubeharnessFigure.state())"
 ],
 [
  "until",
  "document.querySelector('.kh-stage').dataset.phase==='validating'",
  30000
 ],
 [
  "shot",
  "lifecycle-validating.png"
 ],
 [
  "eval",
  "document.querySelector('[data-report]').textContent"
 ],
 [
  "until",
  "document.querySelector('.kh-stage').dataset.phase==='provisioning'",
  30000
 ],
 [
  "until",
  "document.querySelector('.kh-stage').dataset.phase==='wait-usable'",
  30000
 ],
 [
  "shot",
  "lifecycle-wait-usable.png"
 ],
 [
  "until",
  "document.querySelector('.kh-stage').dataset.step==='5'",
  30000
 ],
 [
  "wait",
  1200
 ],
 [
  "shot",
  "lifecycle-install.png"
 ],
 [
  "eval",
  "document.querySelector('[data-say]').textContent"
 ],
 [
  "eval",
  "document.querySelector('[data-piece=\"cart\"]').style.opacity"
 ],
 [
  "until",
  "document.querySelector('.kh-stage').dataset.phase==='cleanup'",
  40000
 ],
 [
  "wait",
  1200
 ],
 [
  "shot",
  "lifecycle-cleanup.png"
 ],
 [
  "eval",
  "document.querySelector('[data-report]').textContent"
 ],
 [
  "until",
  "document.querySelector('.kh-stage').dataset.phase==='cleanup' && [...document.querySelectorAll('[data-lamp]')].map((l) => (l.hasAttribute('data-on') ? 'on' : l.hasAttribute('data-fail') ? 'fail' : l.hasAttribute('data-done') ? 'done' : '-')).join(',')==='done,done,done,done,done,done,on'",
  30000
 ],
 [
  "until",
  "document.querySelector('.kh-stage').dataset.phase==='off'",
  30000
 ],
 [
  "shot",
  "lifecycle-off.png"
 ],
 [
  "eval",
  "document.querySelectorAll('[data-lamp][data-on]').length"
 ],
 [
  "until",
  "[...document.querySelectorAll('[data-lamp]')].map((l) => (l.hasAttribute('data-on') ? 'on' : l.hasAttribute('data-fail') ? 'fail' : l.hasAttribute('data-done') ? 'done' : '-')).join(',')==='done,done,done,done,done,done,done'",
  1000
 ],
 [
  "eval",
  "[...document.querySelectorAll('[data-lamp]')].map((l) => (l.hasAttribute('data-on') ? 'on' : l.hasAttribute('data-fail') ? 'fail' : l.hasAttribute('data-done') ? 'done' : '-')).join(',')"
 ]
]
